# サーバーの設定の見本。写して apps/server/.env を作る（.env は Git に入れない）。
# 空の値（KEY=）は書いていないのと同じで、既定の値を使う。

# ---- 待ち受け ----
# 最初の版は手元だけで動かすので、127.0.0.1・localhost・::1 のどれか（既定：127.0.0.1）
SERVER_HOST=127.0.0.1
# 1〜65535（既定：8787）
SERVER_PORT=8787

# ---- Claude ----
# なくてもサーバーは起動する。Claude を使う会話は、キーがないと分かる文で失敗する
ANTHROPIC_API_KEY=
# 使うモデル（既定：claude-opus-5-5）
ANTHROPIC_MODEL=claude-opus-5-5
# 推論の深さ：low・medium・high・xhigh・max（既定：low。会話の応答は速さを優先する）
ANTHROPIC_EFFORT=low
# 1回の応答の最大の出力量（1〜128000、既定：64000）
ANTHROPIC_MAX_TOKENS=64000

# ---- 道具を使うループ ----
# 1ターンあたりの道具の呼び出しの回数の上限（1〜100、既定：20）
AGENT_MAX_TOOL_CALLS=20

# ---- 部品の設定 ----
# 部品の設定ファイルの場所。相対で書くとリポジトリの根から数える（既定：config/sources.json）
SOURCES_CONFIG_PATH=
